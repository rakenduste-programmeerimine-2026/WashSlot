# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Email when a cycle ends (optional locally: without a key, emails are printed to the server log).
# A Brevo API key (starts with xkeysib-) restricted to transactional emails, and a sender confirmed in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
